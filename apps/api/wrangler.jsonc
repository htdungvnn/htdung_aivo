/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"dev": {
		"port": 3001
	},
	"send_email": [
		{
			"name": "CF_EMAIL",
			"allowed_destination_addresses": ["*@aivo.website", "*@gmail.com", "*@yahoo.com", "*@hotmail.com", "*@outlook.com"]
		}
	],
	"routes": [
		{
			"pattern": "api.aivo.website",
			"zone_name": "aivo.website"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_STATE",
			"id": "d0c14cf3aa4740df94978ed85ca061a9"
		}
	],
	"vars": {
		"NODE_ENV": "production",
		"API_BASE_URL": "https://api.aivo.website",
		"AUTH_ISSUER": "https://api.aivo.website",
		"AUTH_AUDIENCE": "https://aivo.website",
		"AUTH_ACCESS_TOKEN_TTL_SECONDS": "600",
		"AUTH_REFRESH_IDLE_TTL_SECONDS": "2592000",
		"AUTH_REFRESH_ABSOLUTE_TTL_SECONDS": "7776000",
		"AUTH_SIGNING_KEY_ID": "1",
		"GOOGLE_REDIRECT_URI": "https://api.aivo.website/v1/auth/oauth/google/callback",
		"FACEBOOK_REDIRECT_URI": "https://api.aivo.website/v1/auth/oauth/facebook/callback",
		"WEB_APP_URL": "https://aivo.website",
		"MOBILE_CALLBACK_URI": "aivo://auth/callback",
		"EMAIL_FROM": "noreply@aivo.website",
		"ALLOWED_ORIGIN": "https://aivo.website"
	}
}
