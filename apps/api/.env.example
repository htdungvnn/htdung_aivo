# =============================================================================
# API Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# Development
NODE_ENV=development
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Production
# API_BASE_URL=https://api.aivo.website
# FRONTEND_URL=https://aivo.website

# Cloudflare Workers
AUTH_ISSUER=https://api.aivo.website
AUTH_AUDIENCE=https://aivo.website
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_IDLE_TTL_SECONDS=2592000
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=7776000
AUTH_SIGNING_KEY_ID=1

# OAuth - Google
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://api.aivo.website/v1/auth/oauth/google/callback

# OAuth - Facebook
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
# FACEBOOK_REDIRECT_URI=https://api.aivo.website/v1/auth/oauth/facebook/callback

# App URLs
WEB_APP_URL=https://aivo.website
MOBILE_CALLBACK_URI=aivo://auth/callback

# Email
EMAIL_FROM=noreply@aivo.website

# Security
ALLOWED_ORIGIN=https://aivo.website

# KV Namespaces (for local development, use wrangler dev)
# KV_IDS are available in wrangler dev mode automatically
