{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
        "node",
        "vinext/types"
    ],
    "paths": {
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/*": ["./*"],
      "@aivo/i18n": ["../../packages/i18n/src"],
      "@aivo/i18n/*": ["../../packages/i18n/src/*"]
    }
  },
  "include": ["next-env.d.ts", "vite-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "components/**/*.ts", "components/**/*.tsx", "lib/**/*.ts", "lib/**/*.tsx", ".next/types/**/*.ts", ".cloudflare/types"],
  "exclude": ["node_modules"]
}
