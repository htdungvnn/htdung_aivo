# =============================================================================
# Web Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production
# NEXT_PUBLIC_API_URL=https://api.aivo.website

# Auth
AUTH_TOKEN_KEY=aivo_auth_token
AUTH_USER_ID_KEY=aivo_user_id

# OAuth Redirect (for mobile deep linking)
NEXT_PUBLIC_OAUTH_CALLBACK=aivo://auth/callback
