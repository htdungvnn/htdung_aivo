# =============================================================================
# Mobile Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# API Configuration
API_BASE_URL=http://localhost:3001

# Production
# API_BASE_URL=https://api.aivo.website

# Auth Storage Keys
AUTH_TOKEN_KEY=aivo_auth_token
AUTH_USER_ID_KEY=aivo_user_id

# OAuth Callback (for mobile deep linking)
OAUTH_CALLBACK_SCHEME=aivo
OAUTH_CALLBACK_HOST=auth/callback

# Deep Link Configuration
# aivo://auth/callback?token=xxx&userId=xxx
